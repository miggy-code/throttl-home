{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://throttlai.com/schemas/design-run-brief.schema.json",
  "title": "Throttl Website Design Run Brief",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "route",
    "targets",
    "canonical_sources",
    "non_targets",
    "viewports",
    "design_intent",
    "acceptance_criteria",
    "max_iterations",
    "production_status"
  ],
  "properties": {
    "run_id": { "type": "string", "minLength": 1 },
    "route": { "type": "string", "pattern": "^/" },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "canonical_sources": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "non_targets": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "viewports": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "integer",
        "enum": [375, 768, 1440]
      },
      "uniqueItems": true
    },
    "design_intent": { "type": "string", "minLength": 20 },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 10 }
    },
    "max_iterations": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "production_status": {
      "const": "not_published"
    }
  }
}
